NEXT_PUBLIC_SUPABASE_URL=https://wyvdnobucspqrhlaxqet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
# Required by the bundled Android frontend. This is a public origin, never a secret.
NEXT_PUBLIC_TILIO_BACKEND_ORIGIN=https://www.tilio.online

# optional: app opens without sign-in; required: restore the protected entry flow.
NEXT_PUBLIC_AUTH_MODE=optional

# Required by server routes and Supabase Edge Functions that manage cloud data.
SUPABASE_URL=https://wyvdnobucspqrhlaxqet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Required for Telegram Mini App login.
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret

# Optional admin/tester controls.
TESTER_ADMIN_EMAILS=
TESTER_ADMIN_USER_IDS=
